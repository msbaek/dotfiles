#!/bin/bash
# visd — vis daemon server management (start/stop/status/restart/logs)

# Overridable so tests can run against a scratch port without touching the real daemon
PORT="${VISD_PORT:-8741}"
PID_FILE="${VISD_PID_FILE:-$HOME/.vis-server.pid}"
LOG_FILE="${VISD_LOG_FILE:-$HOME/.claude/logs/vis-server.log}"
HEALTH_URL="http://localhost:$PORT/health"

mkdir -p "$(dirname "$LOG_FILE")"

# PID listening on $PORT (empty if none). The port is the source of truth:
# the PID file can be missing or stale.
listener_pid() {
  lsof -nP -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1
}

show_usage() {
  echo "Usage: visd <command>"
  echo ""
  echo "Commands:"
  echo "  start          Start vis daemon server"
  echo "  stop           Stop running server"
  echo "  restart        Stop then start"
  echo "  status         Show PID, document count, index state"
  echo "  logs [N]       Show last N lines of log (default: 30)"
  echo ""
  echo "Config:"
  echo "  Port:     $PORT"
  echo "  PID file: $PID_FILE"
  echo "  Log file: $LOG_FILE"
}

case "${1:---help}" in
  -h|--help|"")
    show_usage
    exit 0
    ;;
  stop)
    pid=$(listener_pid)
    [[ -z "$pid" ]] && pid=$(cat "$PID_FILE" 2>/dev/null)
    if [[ -z "$pid" ]]; then
      echo "No running server found"
      exit 0
    fi
    kill "$pid" 2>/dev/null
    # Wait for the port to be released so a following start does not find the old daemon
    for _ in $(seq 1 30); do
      [[ -z "$(listener_pid)" ]] && break
      sleep 0.5
    done
    rm -f "$PID_FILE"
    if [[ -n "$(listener_pid)" ]]; then
      echo "ERROR: port $PORT still in use 15s after stopping PID $pid"
      exit 1
    fi
    echo "visd stopped (PID: $pid)"
    ;;

  status)
    if curl -sf --max-time 5 "$HEALTH_URL" > /dev/null 2>&1; then
      pid=$(cat "$PID_FILE" 2>/dev/null || echo "?")
      info=$(curl -sf --max-time 5 "$HEALTH_URL")
      docs=$(echo "$info" | jq -r '.document_count // "?"')
      indexed=$(echo "$info" | jq -r '.indexed // "?"')
      echo "✅ visd running (PID: $pid, port: $PORT)"
      echo "   Documents: $docs, Indexed: $indexed"
      echo "   Log: $LOG_FILE"
    else
      echo "❌ visd not running"
    fi
    ;;

  logs)
    if [[ -f "$LOG_FILE" ]]; then
      tail -${2:-30} "$LOG_FILE"
    else
      echo "No log file: $LOG_FILE"
    fi
    ;;

  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;

  start)
    # Already running? Check the port, not health: a daemon busy with a long rerank
    # misses the health timeout but still owns the port
    pid=$(listener_pid)
    if [[ -n "$pid" ]]; then
      echo "$pid" > "$PID_FILE"
      echo "visd already running (PID: $pid)"
      exit 0
    fi

    # Stale PID cleanup
    rm -f "$PID_FILE"

    echo "Starting visd on port $PORT..."
    nohup vis serve --port "$PORT" >> "$LOG_FILE" 2>&1 &
    pid=$!
    echo "$pid" > "$PID_FILE"

    # Wait for ready (max 60s — first start needs index building)
    for i in $(seq 1 60); do
      if curl -sf --max-time 5 "$HEALTH_URL" > /dev/null 2>&1; then
        docs=$(curl -sf --max-time 5 "$HEALTH_URL" | jq -r '.document_count // "?"')
        echo "visd started (PID: $pid, docs: $docs, log: $LOG_FILE)"
        exit 0
      fi
      sleep 1
    done

    echo "ERROR: visd failed to start within 60s (check $LOG_FILE)"
    kill "$pid" 2>/dev/null
    rm -f "$PID_FILE"
    exit 1
    ;;

  *)
    echo "Unknown command: $1"
    show_usage
    exit 1
    ;;
esac
